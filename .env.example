# ===================================================
# APEXTASK — VERCEL & CLOUD MYSQL ENVIRONMENT VARIABLES
# ===================================================

# Single User Authentication (Set on Vercel Dashboard)
APP_USERNAME=mayur
APP_PASSWORD=your_secure_password
JWT_SECRET=your_long_random_secret_string
JWT_EXPIRY_DAYS=7

# Cloud MySQL Database (From PlanetScale, Railway, Aiven, or AWS RDS)
MYSQL_HOST=your-cloud-db-host.railway.app
MYSQL_PORT=3306
MYSQL_USER=your_db_username
MYSQL_PASSWORD=your_db_password
MYSQL_DB=todo_app

# Optional Cloud SSL Certificate CA Path
# MYSQL_SSL_CA=

# Local Development Port
PORT=5000
